{
  "name": "lucky-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm boundaries && pnpm -r typecheck && pnpm -r test && pnpm -r --if-present build",
    "boundaries": "node scripts/check-boundaries.mjs",
    "dev": "pnpm --filter @lucky-arcade/web dev",
    "report": "pnpm --filter @lucky-arcade/report-cli start --",
    "measure:npc": "pnpm --filter @lucky-arcade/report-cli measure:npc --",
    "content:gfl": "pnpm --filter @lucky-arcade/content-cli start --",
    "content:temerosa": "pnpm --filter @lucky-arcade/content-cli temerosa --",
    "content:temerosa:audit": "pnpm --filter @lucky-arcade/content-cli temerosa:audit --",
    "content:temerosa:expressions": "pnpm --filter @lucky-arcade/content-cli temerosa:expressions --",
    "content:temerosa:casino:inventory": "pnpm --filter @lucky-arcade/content-cli temerosa:casino:inventory --",
    "content:temerosa:casino:compile": "pnpm --filter @lucky-arcade/content-cli temerosa:casino:assets:compile --",
    "content:temerosa:casino:audit": "pnpm --filter @lucky-arcade/content-cli temerosa:casino:assets:audit --",
    "content:cards": "pnpm --filter @lucky-arcade/content-cli cards --",
    "content:cards:audit": "pnpm --filter @lucky-arcade/content-cli cards:audit --",
    "content:validate": "pnpm --filter @lucky-arcade/content-cli validate --",
    "dialogue:temerosa:generate": "node scripts/generate-temerosa-old-maid-dialogue.mjs",
    "test": "pnpm boundaries && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
