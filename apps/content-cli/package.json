{
  "name": "@lucky-arcade/content-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "temerosa": "tsx src/temerosa.ts",
    "temerosa:audit": "tsx src/audit-temerosa.ts",
    "temerosa:expressions": "tsx src/audit-temerosa-expressions.ts",
    "temerosa:casino": "tsx src/compile-temerosa-casino.ts",
    "temerosa:casino:audit": "tsx src/audit-temerosa-casino.ts --manifest apps/web/public/content/temerosa-margin/0.8.0/manifest.json --selection apps/content-cli/src/temerosa-casino-selection.json --report reports/temerosa-casino-asset-audit.json",
    "temerosa:casino:inventory": "tsx src/inventory-temerosa-casino-assets.ts",
    "temerosa:series:npcs": "tsx src/inventory-temerosa-series-npcs.ts",
    "temerosa:casino:assets:compile": "tsx src/compile-temerosa-casino-assets.ts",
    "temerosa:casino:assets:audit": "tsx src/audit-temerosa-casino-assets.ts --inventory reports/temerosa-casino-asset-inventory.json --reviews apps/content-cli/src/temerosa-casino-review-queue.json --public-root apps/web/public/content",
    "temerosa:favorite:compile": "tsx src/compile-temerosa-favorite-cup.ts",
    "cards": "tsx src/playing-cards.ts",
    "cards:audit": "tsx src/audit-playing-cards.ts",
    "validate": "tsx src/validate-pack.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucky-arcade/cabinet-sdk": "workspace:*",
    "@lucky-arcade/card-io": "workspace:*",
    "@lucky-arcade/contracts": "workspace:*",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
